# Dùng PostgreSQL local qua Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kronoflow"

# Hoặc dán chuỗi kết nối PostgreSQL từ Supabase (Transaction Pooler cổng 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
